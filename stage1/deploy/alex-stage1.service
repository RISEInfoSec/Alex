[Unit]
Description=ALEX isolated fixture processing

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=alex-stage1
StateDirectoryMode=0700
WorkingDirectory=/opt/alex-stage1
ExecStart=/usr/bin/python3 -m stage1.scheduled_job
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
UMask=0077
TimeoutStartSec=120
