  "assessed_unnumbered": [
    {
      "candidate_id": "soups-70340a5c5c083c629f4f",
      "title": "Kenya’s #RejectFinanceBill2024 Protests: Security, Privacy, and Safety Concerns and Behaviors",
      "recommendation": "discuss",
      "review_reason": "Proposes interviews about technology use and safety during Kenya's 2024 protests, informed by exploratory analysis of public posts. Potentially useful for understanding technology-facilitated targeting and vulnerable-source protection, but the interviews are planned and completed interview findings must not be implied."
    },
    {
      "candidate_id": "soups-b17fd687163379479fb9",
      "title": "“We Have Never Been Attacked”: Unpacking the Illusion of Cybersecurity in Small Business",
      "recommendation": "include",
      "review_reason": "Studies why small-business stakeholders report never being attacked despite limited monitoring and detection. Relevant to under-recognition of compromise and incident reporting, but it studies organizational perceptions rather than measuring criminal activity or proving individual compromises."
    },
    {
      "candidate_id": "soups-9be8ad047d1145bf7666",
      "title": "From Laughter to Concern: Exploring Conversations about Deepfakes on Reddit -Trends and Sentiments",
      "recommendation": "discuss",
      "review_reason": "Analyzes public, safe-for-work Reddit discussion of deepfakes, including tools, scams and misuse-related sentiment. May support OSINT context on the deepfake ecosystem, but it primarily studies discussion and sentiment rather than verified crimes, perpetrators or victim cases."
    },
    {
      "candidate_id": "soups-7c4adaa11ec3fb6b7389",
      "title": "VulnGPT: An LLM-based Agent for Vulnerability Information Summarization",
      "recommendation": "exclude",
      "review_reason": "Evaluates an LLM assistant for collecting and summarizing vulnerability information to support patching. Although criminal exploitation motivates patching, the contribution is general systems administration and does not substantively examine cybercrime, victims, abuse reporting or investigation."
    },
    {
      "candidate_id": "soups-abb21ed4b47e211c244e",
      "title": "Using Signal Detection Theory to Measure Phishing Detection Ability and Behavior",
      "recommendation": "include",
      "review_reason": "Applies signal detection theory to phishing judgments and actions in a 152-person experiment. Provides a concrete method for distinguishing detection ability from decision thresholds when evaluating social-engineering susceptibility."
    }
  ],
